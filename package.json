{
  "name": "observerlauncher",
  "version": "0.1.0",
  "description": "A beginner-friendly and advanced-capable desktop launcher for hosting local Minecraft servers on Windows and Linux.",
  "license": "MIT",
  "author": "ObserverLauncher contributors",
  "keywords": [
    "minecraft",
    "minecraft-server",
    "server-launcher",
    "electron",
    "paper",
    "purpur",
    "fabric",
    "forge"
  ],
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis",
    "build:linux": "electron-builder --linux AppImage",
    "build:all": "electron-builder --win nsis --linux AppImage",
    "test": "node tests/run.js"
  },
  "build": {
    "appId": "dev.observerlauncher.minecraftservercontrol",
    "electronDist": "node_modules/electron/dist",
    "productName": "ObserverLauncher",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Kag4286",
        "repo": "ObserverLauncher"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ObserverLauncher-${version}-setup.exe"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Game"
    },
    "appImage": {
      "artifactName": "ObserverLauncher-${version}.AppImage"
    }
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "prismarine-nbt": "^2.8.0"
  }
}